function [x, i] = secant(f, x0, x1, pars)    if nargin < 4        pars = struct();    end    pars = handle_default_parameters(pars);    % Initial setup    if pars.all_x_values        x_all = [x0, x1];    end    fx0 = f(x0);    fx1 = f(x1);    i = 2; % Start from the second iteration    % Iteration loop    while abs(fx1) > pars.eps && i < pars.imax        df = (fx1 - fx0) / (x1 - x0); % Secant slope approximation        if abs(df) <= 1e-15 % Prevent division by very small slopes            fprintf('Error! dfdx = %g very small at x = %g\n', df, x);            i = -2;            return;        else            x = x1 - fx1 / df; % Update x using secant formula        end        % Shift values for the next iteration        x0 = x1;        fx0 = fx1;        x1 = x;        fx1 = f(x1);        i = i + 1;        % Logging and saving all x values (if enabled)        if pars.print            fprintf('i=%6d x=%16.10g f(x)=%16.10g\n', i, x1, fx1);        end        if pars.all_x_values            x_all(end+1) = x;        end    end    % Final adjustments for outputs    if pars.all_x_values        x = x_all;    end    if abs(fx1) > pars.eps        i = -1; % Did not converge    endendfunction new_pars = handle_default_parameters(pars)    % Set default values for parameters    new_pars = struct('eps', 1e-6, 'imax', 100, ...                      'all_x_values', false, 'print', false);    if isfield(pars, 'eps');        new_pars.eps = pars.eps;    end    if isfield(pars, 'imax');        new_pars.imax = pars.imax;    end    if isfield(pars, 'all_x_values');        new_pars.all_x_values = pars.all_x_values;    end    if isfield(pars, 'print');        new_pars.print = pars.print;    endend